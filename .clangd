CompileFlags:
  Add:
    - -xcuda
    # clangd 18 knows GPUs up to sm_90. Editor only: nvcc still builds for the real GPU.
    - --cuda-gpu-arch=sm_90
    - -std=c++20
    - -I/usr/local/cuda/include
    # CUDA 13 moved thrust, cub and cuda:: here; nvcc adds it itself, clang does not.
    - -isystem/usr/local/cuda/include/cccl
    # Relative to build/ (where compile_commands.json lives). See the stub for why.
    - -isystem../tools/clangd
  Remove:
    - -x
    - -Xptxas*
    - -forward-unknown-to-host-compiler
    - --generate-code*
    - -Xcompiler*
    - -Xcudafe*
    - --expt-*
    - -arch=*
    - -rdc=*
    - --options-file
    - --options-file=*
---
# clangd 18 preamble bug: false "operator new" host/device errors from clang's own
# cuda_wrappers/new in files that include thrust. Kernels keep the real check.
If:
  PathMatch: src/[^/]+\.cu
Diagnostics:
  Suppress: [ref_bad_target]

